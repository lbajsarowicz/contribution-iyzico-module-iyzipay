{
    "name": "iyzico/module-iyzipay",
    "description": "iyzico Payment Gateway For Magento 2",
    "type": "magento2-module",
    "version": "1.0.0",
    "license": "GPL-3.0",
    "authors": [
        {
            "name": "iyzico",
            "email": "info@iyzico.com"
        }
    ],
    "minimum-stability": "dev",
    "require": {},
    "autoload": {
